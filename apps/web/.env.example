# Backend origin. Leave empty while using the mock API, and in development (Vite forwards /api to
# the backend on port 8787).
VITE_API_URL=
# The mock API (MSW) answers /api/* in the browser. Set to "off" to use the real backend instead;
# it covers browsing, buying and sign-in so far, so organizer tools, check-in and admin need the mock.
VITE_API_MOCKS=on
