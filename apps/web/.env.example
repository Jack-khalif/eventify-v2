# Backend origin. Leave empty while using the mock API, and in development (Vite forwards /api to
# the backend on port 8787).
VITE_API_URL=
# The mock API (MSW) answers /api/* in the browser, with sample data and no backend running.
# Set to "off" to use the real backend instead. Always "off" for a production build.
VITE_API_MOCKS=on
