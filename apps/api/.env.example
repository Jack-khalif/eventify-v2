# Postgres connection string (e.g. Neon's pooled URL). Leave empty in development to use a local
# database file in apps/api/.data, which needs no setup.
DATABASE_URL=

# Where the web app lives; ticket links in emails point here.
SITE_URL=http://localhost:5173

# Resend API key (https://resend.com/api-keys). Leave empty to print emails to the terminal instead.
RESEND_API_KEY=
# Must be an address on a domain verified in Resend. Until you have one, Resend's test sender
# below works but only delivers to the email address of your own Resend account.
EMAIL_FROM=Eventify <onboarding@resend.dev>

# simulated = pretend M-Pesa (outcome picked by the phone's last four digits, as in the mock API).
# off = free tickets only. Defaults to simulated in development and off in production, so nobody
# gets paid tickets for nothing before real payments exist.
PAYMENTS=

# Ed25519 private key (JWK, one line) that signs ticket QR codes. Make one with `npm run keygen`.
# Required in production; development makes a throwaway key on each start.
QR_PRIVATE_KEY=

# Comma-separated emails that are Super Admins when they sign in. This is how the first admin gets
# in; everyone else's role is set from the admin portal.
SUPER_ADMIN_EMAILS=

PORT=8787
