{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    /*
     * Runs in the browser and in Node (API). Web Crypto type names (CryptoKey, JsonWebKey) come
     * from the DOM lib; Node provides the same globals at runtime.
     */
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["src"]
}
